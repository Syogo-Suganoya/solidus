<%= render component("ui/panel").new(title: t(".title")) do |panel| %>
  <% if product_properties.present? %>
    <% panel.with_section do %>
      <div class="flex flex-col gap-4" data-controller="sortable" data-sortable-handle-value=".handle">
        <% product_properties.each_with_index do |product_property, index| %>
          <div class="flex gap-2 items-center" data-sortable-url="<%= solidus_admin.move_product_property_path(product_property) %>">
            <%= render component("ui/icon").new(name: "draggable", class: "w-6 h-6 shrink-0 cursor-grab handle fill-gray-500") %>
            <%= hidden_field_tag field_name(index, :id), product_property.id, id: nil %>
            <%= hidden_field_tag field_name(index, :property_name), product_property.property_name, id: nil %>
            <span class="w-1/3 shrink-0 font-semibold text-sm"><%= product_property.property.presentation %></span>
            <%= render component("ui/forms/input").new(
              name: field_name(index, :value),
              value: product_property.value,
              "aria-label": t(".value_for", property: product_property.property.presentation)
            ) %>
            <%= link_to(
              t(".remove"),
              solidus_admin.product_property_path(product_property),
              "aria-label": t(".remove_property", property: product_property.property.presentation),
              "data-turbo-method": :delete,
              "data-turbo-confirm": t(".remove_confirmation"),
              class: "body-link !text-red-500 shrink-0"
            ) %>
          </div>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="flex gap-4 justify-between items-end">
    <%= render component("ui/forms/select").new(
      label: t(".property"),
      name: field_name(new_index, :property_name),
      choices: property_options,
      include_blank: true
    ) %>
    <%= render component("ui/forms/field").new(
      label: t(".value"),
      input_attributes: {name: field_name(new_index, :value), value: nil}
    ) %>
    <%= render component("ui/button").new(type: :submit, text: t(".save")) %>
  </div>

  <% panel.with_action(
    name: t(".manage_properties"),
    scheme: :secondary,
    href: spree.admin_product_product_properties_path(@product)
  ) %>
<% end %>
